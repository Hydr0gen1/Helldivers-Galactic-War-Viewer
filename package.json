{
  "name": "helldivers-intel",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "build": "npm run build --workspace client && npm run build --workspace server && npm run copy:client",
    "copy:client": "cp -r client/dist server/dist/public",
    "start": "node server/dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b server client --noEmit",
    "test": "npm test --workspaces --if-present",
    "dive": "docker compose up --build",
    "dive:detached": "docker compose up --build -d",
    "dive:logs": "docker compose logs -f",
    "dive:down": "docker compose down",
    "extract": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  }
}
