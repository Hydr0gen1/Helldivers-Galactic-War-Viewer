# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Server ---
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# --- Poller ---
POLL_INTERVAL_MS=60000
HELLDIVERS_API_BASE=https://api.helldivers2.dev/api/v1
HELLDIVERS_USER_AGENT=helldivers-intel/1.0 (github.com/<owner>/<repo>)
HELLDIVERS_MIN_REQUEST_GAP_MS=10000

# --- Analyzer ---
ANALYZER_INTERVAL_MS=300000
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANALYZER_MAX_TOKENS=600
ANALYZER_TIMEOUT_MS=20000

# --- Client (baked at build time via Vite) ---
VITE_APP_TITLE=Helldivers Intel
