# Select active provider: anthropic | fireworks | cerebras
AI_PROVIDER=anthropic

# Provider API keys (runtime-only secrets).
# Set only the key that matches AI_PROVIDER; leave others blank.
# Do not commit real keys. Never expose keys to the client.
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Provider models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p1
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ANALYZER_MAX_TOKENS=600
ANALYZER_TIMEOUT_MS=20000
ANALYZER_INTERVAL_MS=300000
POLL_INTERVAL_MS=60000
HELLDIVERS_API_BASE=https://api.helldivers2.dev/api/v1
HELLDIVERS_USER_AGENT=helldivers-intel/1.0
HELLDIVERS_MIN_REQUEST_GAP_MS=10000

WAR_CHRONICLE_ENABLED=true
WAR_CHRONICLE_DB_PATH=/app/data/helldivers-intel.sqlite
WAR_CHRONICLE_RETENTION_DAYS=30
