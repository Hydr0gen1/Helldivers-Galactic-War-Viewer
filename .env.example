# Select active provider: anthropic | fireworks | cerebras
AI_PROVIDER=anthropic

# Provider API keys are kept in .secrets.env (copy from .secrets.example.env).
# Set only the key that matches AI_PROVIDER in your local .secrets.env.

# Provider models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Fireworks model must use the full model path, for example:
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
FIREWORKS_MODEL=
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

# OpenAI-compatible Fireworks base URL
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ANALYZER_MAX_TOKENS=600
ANALYZER_TIMEOUT_MS=20000
ANALYZER_INTERVAL_MS=300000
POLL_INTERVAL_MS=60000
HELLDIVERS_API_BASE=https://api.helldivers2.dev/api/v1
HELLDIVERS_USER_AGENT=helldivers-intel/1.0
HELLDIVERS_MIN_REQUEST_GAP_MS=10000
HELLDIVERS_SUPER_CLIENT=Helldivers-Galactic-War-Viewer
HELLDIVERS_SUPER_CONTACT=https://github.com/Hydr0gen1/Helldivers-Galactic-War-Viewer

WAR_CHRONICLE_ENABLED=true
WAR_CHRONICLE_DB_PATH=/app/data/helldivers-intel.sqlite
WAR_CHRONICLE_RETENTION_DAYS=30
