# Copy this file to .secrets.env and fill in real API keys locally.
# Never commit .secrets.env.

# Only set the key for the active provider.
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Optional advanced provider-specific values.
# Leave blank unless your provider account explicitly requires them.
FIREWORKS_EXTRA_HEADERS_JSON=
